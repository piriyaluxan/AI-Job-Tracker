generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Job {
  id        String   @id @default(cuid())
  title     String
  company   String
  status    String
  location  String?
  url       String?
  notes     String?
  createdAt DateTime @default(now())
}